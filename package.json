{
  "name": "@portone/cli",
  "version": "0.0.2",
  "private": false,
  "description": "PortOne 결제/본인인증 연동을 위한 CLI 도구 (Claude Code/Codex 지원)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "portone": "./bin/portone.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "plugins",
    ".agents"
  ],
  "keywords": [
    "portone",
    "payment",
    "identity-verification",
    "claude-code",
    "codex",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
